{
    "name": "bagamoyo/municipal-management",
    "type": "project",
    "description": "Bagamoyo Municipal Management System - Business License, Fishery, Markets, and Business Frames Management",
    "keywords": ["laravel", "municipal", "bagamoyo", "tanzania"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/framework": "^11.36",
        "laravel/tinker": "^2.9",
        "laravel/ui": "^4.6",
        "spatie/laravel-permission": "^6.10",
        "yajra/laravel-datatables-oracle": "^11.0",
        "barryvdh/laravel-dompdf": "^3.0",
        "maatwebsite/excel": "^3.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "audit": {
        "block-insecure": false
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
		"audit": {
			"ignore": [
				"PKSA-m5cs-t1y6-qpcs",
				"PKSA-3r5d-mb8f-1qw9",
				"PKSA-mdq4-51ck-6kdq",
				"PKSA-8qx3-n5y5-vvnd"
			]
		}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
